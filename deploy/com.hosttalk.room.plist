<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hosttalk.room</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/hosttalk/.venv/bin/python</string>
    <string>-m</string>
    <string>hosttalk</string>
    <string>serve</string>
    <string>--headless</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/usr/local/hosttalk</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOSTTALK_HOME</key>
    <string>/Users/Shared/HostTalk</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/Shared/HostTalk/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/HostTalk/logs/launchd.err.log</string>
</dict>
</plist>
