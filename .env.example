# Environment overrides for HostTalk.
# Settings normally live in config.json inside the data folder.
# Copy this file to .env only when you need to pin a value for a deployment.

# HOSTTALK_PORT=7284
# HOSTTALK_BIND=0.0.0.0
# HOSTTALK_HOME=/var/lib/hosttalk
# HOSTTALK_NO_BROWSER=1
# HOSTTALK_CONSOLE_LOCAL_ONLY=1
# HOSTTALK_MAX_UPLOAD_MB=20
# HOSTTALK_MAX_MEMBERS=20
# HOSTTALK_THEME=auto
# LOG_LEVEL=INFO

# GIF search stays off until you add a free key from https://developers.giphy.com/
# GIPHY_API_KEY=

# LocalSend PIN for incoming transfers.
# HOSTTALK_LS_PIN=

# Legacy: a plain password here is hashed into config.json on first start.
# Prefer "python server.py setup" or the host console.
# SERVER_PASSWORD=
